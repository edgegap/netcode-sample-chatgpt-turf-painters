{
  "name": "turf-painters",
  "private": true,
  "type": "module",
  "description": "Turf Painters: a browser game written by ChatGPT as one HTML file, made online multiplayer on Edgegap",
  "engines": { "node": ">=22" },
  "scripts": {
    "split": "node tools/split-artifact.mjs artifact/turf-painters.html",
    "check:rules": "node tools/split-artifact.mjs artifact/turf-painters.html --check",
    "server": "node server/main.js",
    "client": "npx -y http-server client -p 8080 -c-1",
    "test:local": "npm run check:rules && node tests/local-match.mjs",
    "e2e": "node tests/e2e.mjs turf-painters 2"
  },
  "dependencies": {
    "@edgegap/sdk": "^1.1.0",
    "ws": "^8.22.1"
  }
}
